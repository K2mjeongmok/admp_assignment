<mujoco model="gen3_scene">
  <include file="gen3_7dof_mujoco_left.xml"/>
  <include file="gen3_7dof_mujoco_right.xml"/>
  <option timestep="0.001" integrator="implicitfast"/>

  <default class="main">
    <joint pos="0 0 0" axis="0 0 1" damping="0.2"/>
    <motor ctrllimited="true" forcelimited="false" />
    <geom group="1" type="mesh" rgba="0.75294 0.75294 0.75294 1" contype="1" conaffinity="1"/>
    <default class="infiniteJoints">
      <joint limited="false"/>
    </default>
    <default class="limitedJoints">
      <joint limited="true"/>
    </default>
  </default>


  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="tilt_base" pos="0 0 0.3" quat="1 0 0 0">
      <geom type="box" size="0.12 0.12 0.3" rgba="0.5 0.5 0.5 1"/>
      <body name="tilt_1" pos="0 0 0.425" quat="1 0 0 0">
        <geom type="box" size="0.08 0.08 0.125" rgba="0.5 0.5 0.5 1"/>
        <body name="tilt_2" pos="0 0 0.25" quat="1 0 0 0">
          <geom type="box" size="0.065 0.065 0.125" rgba="0.5 0.5 0.5 1"/>
          <body name="neck" pos="0 0 0.275" quat="1 0 0 0">
            <geom type="box" size="0.04 0.04 0.15" rgba="0.5 0.5 0.5 1"/>
          </body>
        </body>
      </body>
    </body>

    <geom name="desk" type="box" pos="0.5 0 0.725" size="0.3 0.5 0.02" rgba="0.8 0.4 0.2 1" solref="0.005 1"/>
  </worldbody>
  <keyframe>
    <key name="home" qpos="-1.75267 1.50887 1.24363 2.08579 -0.825444 -0.472378 0.770404 0 0.3 0.3 0.3 0 0.3 0.3 0.3 0 0.3 0.3 0.3 0.7 0.3 0.3 0.3 -1.39622 -1.48311 1.8285 2.08713 0.695164 -0.439585 -0.689867 0 0.3 0.3 0.3 0 0.3 0.3 0.3 0 0.3 0.3 0.3 0.7 0.3 0.3 0.3"/>
  </keyframe>
